    {
      "type": "concept_deep_dive",
      "title": "The Convoy Effect & SJF Resolution",
      "problem": {
        "name": "Convoy Effect in FCFS",
        "definition": "A performance bottleneck where multiple short CPU-bound or I/O-bound processes get stuck waiting behind one single long CPU-bound process, just like cars stuck behind a slow truck on a single-lane road.",
        "consequences": [
          "Drastically inflates Average Waiting Time and Turnaround Time (as seen in Example 01 where P2 and P3 waited 23 and 25 units behind P1's 24-unit burst).",
          "Lowers CPU and I/O device utilization because fast I/O-bound processes sit idle in the ready queue instead of initiating disk/network operations."
        ]
      },
      "solution": {
        "name": "How Shortest Job First (SJF) Solves It",
        "mechanism": "Non-preemptive SJF selects the available process with the smallest Burst Time next rather than strictly following arrival order, allowing quick tasks to clear the queue immediately.",
        "comparison": {
          "dataset": [
            { "process": "P1", "arrival_time": 0, "burst_time": 24 },
            { "process": "P2", "arrival_time": 0, "burst_time": 3 },
            { "process": "P3", "arrival_time": 0, "burst_time": 3 }
          ],
          "fcfs_gantt": [
            { "process": "P1", "start": 0, "end": 24 },
            { "process": "P2", "start": 24, "end": 27 },
            { "process": "P3", "start": 27, "end": 30 }
          ],
          "fcfs_avg_wt": "17.0 units",
          "sjf_gantt": [
            { "process": "P2", "start": 0, "end": 3 },
            { "process": "P3", "start": 3, "end": 6 },
            { "process": "P1", "start": 6, "end": 30 }
          ],
          "sjf_avg_wt": "3.0 units",
          "improvement": "Average Waiting Time drops from 17.0 units to 3.0 units (an 82% reduction) on the exact same workload."
        }
      }
    }
